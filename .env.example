# Base de donnees PostgreSQL
POSTGRES_USER=entretien_user
POSTGRES_PASSWORD=entretien_pass_2026
POSTGRES_DB=entretien_garanti
DB_PORT=5432

# Ports des services
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Securite JWT & Regles metier
JWT_SECRET_KEY=secret_key_entretien_garanti_2026_a_changer
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEFAULT_PLAN=decouverte
STOP_RULE_ON_INTERVIEW=true

# Service LLM (a renseigner uniquement dans .env)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.25